# source-observatory — Environment Variables
# Copia in .env solo se serve sovrascrivere i default.

# Backend artifact: auto|gcs|local
# SO_ARTIFACT_BACKEND=auto

# Cache locale: età massima in ore (default: 24)
# SO_CACHE_MAX_AGE_HOURS=24

# GCS prefix per catalog inventory (default: gs://dataciviclab-clean/catalog_inventory)
# CATALOG_INVENTORY_GCS_PREFIX=gs://dataciviclab-clean/catalog_inventory

# Google Cloud Storage
# GOOGLE_APPLICATION_CREDENTIALS=path/to/sa.json
